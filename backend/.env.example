FLASK_APP=run.py
FLASK_ENV=development
DATABASE_URL=sqlite:///recon.db
REDIS_URL=redis://localhost:6379
JWT_SECRET_KEY=your-secret-key
VT_API_KEY=your-virustotal-key
MAX_FREE_SCANS_PER_MONTH=3

# Email (for sending PDFs)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=noreply@recon-platform.com

# Substack
SUBSTACK_URL=https://aceyaai.substack.com
# SUBSTACK_API_KEY= (optional)
CONTACT_EMAIL=aceyathedev@gmail.com